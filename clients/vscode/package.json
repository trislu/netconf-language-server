                      "static",
                      "deprecated",
                      "abstract",
                      "async",
                      "modification",
                      "documentation",
                      "defaultLibrary"
                    ]
                  },
                  "uniqueItems": true
                }
              },
              "markdownDescription": "`+` string-concatenation operators."
            }
          },
          "markdownDescription": "Per-role semantic-token classification. Each member is one YANG construct family (role); its value selects the **token type** (any standard `SemanticTokenType`) and the **modifiers** (multi-select, any standard `SemanticTokenModifier`). The server announces the full standard legend, so changes apply without a restart. A role left out keeps its built-in classification; an unknown role or type is ignored.\n\nExample:\n```jsonc\n\"netconf.semantic\": {\n  \"enumAndBitNames\": { \"token\": \"enumMember\" },\n  \"units\": { \"token\": \"variable\", \"modifiers\": [\"readonly\"] }\n}\n```"
        }
      }
    },
    "configurationDefaults": {
      "[yang]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
